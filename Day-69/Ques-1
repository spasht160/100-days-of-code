#include <stdio.h>

int main() {
    int arr[100], seen[1000] = {0};
    int n, i;

    scanf("%d", &n);

    for (i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    for (i = 0; i < n; i++) {
        if (seen[arr[i]] == 1) {
            printf("%d\n", arr[i]);
            return 0;
        }
        seen[arr[i]] = 1;
    }

    return 0;
}
