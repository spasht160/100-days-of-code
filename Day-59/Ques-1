#include <stdio.h>

int main() {
    int arr[100], n, k, i, j;
    int sum, maxSum;

    scanf("%d", &n);

    for (i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    scanf("%d", &k);

    if (k <= 0 || k > n) {
        printf("-1\n");
        return 0;
    }

    maxSum = 0;

    for (i = 0; i < k; i++) {
        maxSum += arr[i];
    }

    sum = maxSum;

    for (i = k; i < n; i++) {
        sum = sum + arr[i] - arr[i - k];

        if (sum > maxSum) {
            maxSum = sum;
        }
    }

    printf("%d\n", maxSum);

    return 0;
}
