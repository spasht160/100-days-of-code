#include <stdio.h>

int main() {
    FILE *fp;
    char text[200];

    fp = fopen("data.txt", "a");

    if (fp == NULL) {
        printf("Error opening file!\n");
        return 1;
    }

    fgets(text, sizeof(text), stdin);

    fprintf(fp, "%s", text);

    fclose(fp);

    printf("File updated successfully with appended text.\n");

    return 0;
}
