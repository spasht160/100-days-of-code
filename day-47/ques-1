#include <stdio.h>

int main() {
    char a[100], b[100];
    int freq[256] = {0}, i;

    scanf("%99s", a);
    scanf("%99s", b);

    for (i = 0; a[i] != '\0'; i++) {
        freq[(unsigned char)a[i]]++;
    }

    for (i = 0; b[i] != '\0'; i++) {
        freq[(unsigned char)b[i]]--;
    }

    for (i = 0; i < 256; i++) {
        if (freq[i] != 0) {
            printf("Not anagrams");
            return 0;
        }
    }

    printf("Anagrams");

    return 0;
}
