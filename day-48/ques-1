#include <stdio.h>
#include <string.h>

int main() {
    char a[100], b[100], temp[200];
    int i, j, len1, len2;

    scanf("%99s", a);
    scanf("%99s", b);

    len1 = strlen(a);
    len2 = strlen(b);

    if (len1 != len2) {
        printf("Not rotation");
        return 0;
    }

    strcpy(temp, a);
    strcat(temp, a);

    if (strstr(temp, b) != NULL)
        printf("Rotation");
    else
        printf("Not rotation");

    return 0;
}
