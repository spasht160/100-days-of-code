#include <stdio.h>

int main() {
    char name[100];
    int i, start = 0, last = 0;

    scanf(" %[^\n]", name);

    for (i = 0; name[i] != '\0'; i++) {
        if (name[i] == ' ') {
            printf("%c.", name[start]);
            start = i + 1;
            last = i + 1;
        }
    }

    printf("%s", name + last);

    return 0;
}
