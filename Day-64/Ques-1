#include <stdio.h>
#include <string.h>

int main() {
    char s[1000];
    int i, j, k, len, count, maxLen = 0;
    int found;

    scanf("%999s", s);
    len = strlen(s);

    for (i = 0; i < len; i++) {
        int seen[256] = {0};
        count = 0;

        for (j = i; j < len; j++) {
            if (seen[(unsigned char)s[j]]) {
                break;
            }

            seen[(unsigned char)s[j]] = 1;
            count++;
        }

        if (count > maxLen) {
            maxLen = count;
        }
    }

    printf("%d\n", maxLen);

    return 0;
}
